# ============================================================
# DevFlow - variáveis de ambiente
# Copie este arquivo para ".env" e troque os valores.
#   cp .env.example .env
# NUNCA versione o arquivo .env (já está no .gitignore).
# ============================================================

# --- Banco de dados (MySQL) ---
DB_NAME=devflow
DB_USERNAME=devflow
DB_PASSWORD=troque_esta_senha
DB_ROOT_PASSWORD=troque_esta_senha_root

# --- JWT ---
# Mínimo de 32 caracteres. Gere um valor aleatório, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque_este_segredo_por_um_valor_longo_e_aleatorio_com_mais_de_32_caracteres
# Tempo de expiração do token em milissegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# --- Administrador inicial (opcional) ---
# Se preenchidos, um usuário ADMIN é criado na primeira execução.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@devflow.com
ADMIN_PASSWORD=troque_esta_senha_admin
